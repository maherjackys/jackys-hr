/* ══════════════════════════════════════════════
   Jacky's HR Assistant — Stylesheet
   ══════════════════════════════════════════════ */

/* ── Google Fonts ── */
@import url('https://fonts.googleapis.com/css2?family=Lato:wght@400;600;700&family=Montserrat:wght@400;500;700&display=swap');

/* ── العنوان الرئيسي ── */
.main-title {
    color: #ED1C24 !important;
    font-family: "Lato", sans-serif !important;
    font-weight: 700;
    font-size: 2.2rem;
    text-align: center;
    margin-bottom: 4px;
    display: block;
}

/* ── العنوان الفرعي ── */
.sub-title {
    font-family: "Montserrat", sans-serif !important;
    text-align: center;
    font-size: 1.05rem;
    margin-bottom: 28px;
    font-weight: 400;
    display: block;
    opacity: 0.75;
}

/* ── مؤشر التحميل ── */
.stSpinner > div {
    border-top-color: #ED1C24 !important;
}

/* ── رسائل الدردشة — شكل عام ── */
[data-testid="stChatMessageUser"],
[data-testid="stChatMessageAssistant"] {
    border-radius: 10px !important;
    padding: 12px 16px !important;
    margin-bottom: 10px !important;
}

/* ── رسائل المستخدم — حد أحمر يمين ── */
[data-testid="stChatMessageUser"] {
    border-right: 4px solid #ED1C24 !important;
    border-left: none !important;
}

/* ── رسائل المساعد — حد رمادي يسار ── */
[data-testid="stChatMessageAssistant"] {
    border-left: 4px solid #54595F !important;
    border-right: none !important;
}